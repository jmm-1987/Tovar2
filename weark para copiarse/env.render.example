# =============================================================================
# Plantilla de variables para Render.com (Web Service)
# =============================================================================
# En Render NO subas un archivo .env al repositorio con secretos reales.
# Copia estas claves en: Dashboard → tu servicio → Environment → Environment Variables
# y rellena los valores. Puedes usar este archivo solo como lista de comprobación local
# (sin contraseñas), renombrándolo o copiando línea a línea.
#
# Render inyecta automáticamente RENDER=true; no hace falta definirla salvo pruebas locales.
# =============================================================================

# --- Obligatorio ---
SECRET_KEY=genera-una-cadena-larga-aleatoria

# SQLite en disco persistente: crear un "Disk" en Render y montarlo en /data
DATABASE_PATH=/data/pedidos.db

# URL pública del servicio (emails y enlaces al portal cliente si no hay request HTTP)
# Ejemplo: https://tu-app.onrender.com
APP_BASE_URL=

# --- Email (SMTP) ---
# La app acepta MAIL_* o EMAIL_* (ver app.py)
EMAIL_HOST=smtp.tu-proveedor.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USER=
EMAIL_PASS=
MAIL_DEFAULT_SENDER=

# --- Verifactu (si usas facturación) ---
VERIFACTU_TOKEN=
# VERIFACTU_URL=https://api.verifacti.com/verifactu/create

# --- SFTP imágenes (si aplica) ---
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASS=
SFTP_DIR=/
SFTP_BASE_URL=

# --- Presupuestos: enlace público cliente ---
CLIENT_TOKEN_EXPIRY_DAYS=7
INTERNAL_NOTIFICATION_EMAIL=

# --- Opcional: forzar producción en otro host (normalmente no hace falta) ---
# RENDER=true
